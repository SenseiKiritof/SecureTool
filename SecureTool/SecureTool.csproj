<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Authors>SenseiKiritof</Authors>
        <Copyright>SenseiKiritof</Copyright>
        <Owners>SenseiKiritof</Owners>
        <PackageProjectUrl>https://github.com/SenseiKiritof/SecureTool</PackageProjectUrl>
        <RepositoryUrl>https://github.com/SenseiKiritof/SecureTool.git</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Title>SecureTool</Title>
        <Description>Secure Console Tool</Description>
        <PackageVersion>1.1.1</PackageVersion>

        <PackAsTool>true</PackAsTool>
        <ToolCommandName>secureTool</ToolCommandName>

        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>SecureTool</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Sharprompt" Version="3.2.0" />
      <PackageReference Include="SSecureUtils" Version="1.1.1" />
      <!-- Override transitivo di Microsoft.Extensions.Configuration.Json 8.0.0,
           che altrimenti risolve System.Text.Json 8.0.0 (CVE-2024-30105). -->
      <PackageReference Include="System.Text.Json" Version="8.0.6" />
    </ItemGroup>

    <ItemGroup>
      <None Include="../README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

</Project>
